# ─────────────────────────────────────────────────────────────────────────────
# Logswire — self-hosted configuration
# Copy this file to .env (composer install does it for you), fill in the values,
# then `docker compose up -d`.
# ─────────────────────────────────────────────────────────────────────────────

# Random 32+ char string used by Symfony for CSRF, remember-me and signed URIs.
# REQUIRED: the app refuses to boot with APP_ENV=prod while this placeholder is
# still in place. Generate one with: openssl rand -hex 32
APP_SECRET=change-me-32-chars-minimum

# Public host your users will hit. Used to build project DSNs and absolute URLs.
# In production this must be the HTTPS URL served by your reverse proxy.
# Must match APP_HTTP_PORT below (change both to 8081 if 8080 is taken).
APP_PUBLIC_URL=http://localhost:8080

# Host port published by Docker. The container always listens on 8080 and the
# mapping is bound to 127.0.0.1: keep a TLS proxy in front.
APP_HTTP_PORT=8080

# PostgreSQL credentials. `docker compose up` refuses to start while
# POSTGRES_PASSWORD is empty, so pick a strong value first.
# Generate one with: openssl rand -hex 32
# `docker compose down -v` deletes the data volume.
POSTGRES_DB=logswire
POSTGRES_USER=logswire
POSTGRES_PASSWORD=
# Loopback-only port for `composer test-pg` / psql. Never expose it publicly.
# POSTGRES_HOST_PORT=5433

# Doctrine connection string. Docker Compose overrides the host with the
# `postgres` service name; for a native install point it at your own server.
DATABASE_URL="postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@postgres:5432/${POSTGRES_DB}?serverVersion=16&charset=utf8"

# Reverse proxy. Leave empty for direct access (localhost:8080). Behind Nginx,
# Caddy, Traefik or NPM, set the proxy IP/CIDR so Symfony honours
# X-Forwarded-Proto / X-Forwarded-For from that hop only, e.g.
#   TRUSTED_PROXIES=172.18.0.0/16
# "REMOTE_ADDR" is a Symfony special value that trusts the direct peer; only
# use it when the app is unreachable except through its proxy.
TRUSTED_PROXIES=

# File lock for rate limiter and retention (shared across app containers).
# Docker Compose sets flock:///data/locks on the logswire-runtime volume (three slashes).
LOCK_DSN=flock

# Days of events/issues to keep. Default: 15 (set 90+ only if you accept a larger database).
# Retention prune runs automatically (throttled ~1/day) from the worker — no host cron.
# Force now: bin/console app:retention:cleanup (see README).
LOGSWIRE_RETENTION_DAYS=15

# Telegram alerts — leave both empty to disable. When set, Logswire sends a
# single Telegram message on the FIRST occurrence of a new error/fatal issue
# for each project (silent after that; counts keep growing on the dashboard).
LOGSWIRE_TELEGRAM_BOT_TOKEN=
LOGSWIRE_TELEGRAM_CHAT_ID=
# Resolved issues reopen automatically on new events. Set to 1 to also send a
# Telegram alert when that happens.
# LOGSWIRE_TELEGRAM_RENOTIFY_REOPENED=0

# Ingest limits (optional). Defaults: 10 MiB body, 50 items, 1 MiB per item.
# LOGSWIRE_INGEST_MAX_BODY_BYTES=10485760
# LOGSWIRE_INGEST_MAX_ITEMS=50
# LOGSWIRE_INGEST_MAX_ITEM_BYTES=1048576
# Read by the bundled Caddyfile (not by PHP): the proxy rejects oversized bodies
# before they reach PHP. Keep it >= LOGSWIRE_INGEST_MAX_BODY_BYTES / 1 MiB.
# INGEST_MAX_BODY_MB=12

# Redact password/token/cookie/authorization fields before storing the raw
# Sentry payload (recommended). Set to 0 only if you need untouched payloads.
# LOGSWIRE_SCRUB_SENSITIVE=1

# Uptime monitoring (optional). Probe loop runs in its own Compose service.
# LOGSWIRE_UPTIME_TICK_SECONDS=10
# LOGSWIRE_UPTIME_PROBE_BATCH=20
# LOGSWIRE_UPTIME_HTTP_TIMEOUT_MS=5000
# LOGSWIRE_UPTIME_RETRY_COUNT=2
# LOGSWIRE_UPTIME_RETRY_DELAY_SECONDS=1
# LOGSWIRE_UPTIME_HOUR_RETENTION_DAYS=10
# LOGSWIRE_UPTIME_RETENTION_DAYS=90
