{% extends 'base.html.twig' %}
{% import 'macros/csrf.html.twig' as csrf %}

{% block title %}{{ title }}{% endblock %}
{% block head %}<meta name="robots" content="noindex">{% endblock %}

{% block body %}
<section class="page">
    <header class="page-header">
        <h1>Edit {{ monitor.name }}</h1>
    </header>

    {% if error %}
        <p class="flash flash-error">{{ error }}</p>
    {% endif %}

    <div class="form-panel">
    <form method="post" action="{{ path('monitors_edit', {id: monitor.id}) }}" class="form">
        {% include 'monitors/_form.html.twig' with {form: form, with_enabled: true} only %}
        {{ csrf.input('monitor_action') }}
        <div class="form-actions">
            <a href="{{ path('monitors_get', {id: monitor.id}) }}" class="btn">Cancel</a>
            <button type="submit" class="btn btn-primary">Save</button>
        </div>
    </form>
    </div>
</section>
{% endblock %}
