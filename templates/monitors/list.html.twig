{% extends 'base.html.twig' %}

{% block title %}{{ title }}{% endblock %}
{% block head %}<meta name="robots" content="noindex">{% endblock %}

{% block body %}
<section class="page">
    <header class="page-header">
        <div>
            <h1>Monitors</h1>
            <p class="muted small page-subtitle">HTTP endpoints checked on a fixed interval. Down and recovered transitions are sent to Telegram.</p>
        </div>
        <a class="btn btn-primary" href="{{ path('monitors_new') }}">New monitor</a>
    </header>

    {% for label, messages in app.flashes %}
        {% for message in messages %}
            <p class="flash flash-{{ label }}">{{ message }}</p>
        {% endfor %}
    {% endfor %}

    {% include 'monitors/_table.html.twig' with {monitors: monitors} only %}
</section>
{% endblock %}
