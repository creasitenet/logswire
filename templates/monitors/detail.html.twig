{% extends 'base.html.twig' %}
{% import 'macros/csrf.html.twig' as csrf %}
{% import 'macros/empty_state.html.twig' as empty %}

{% block title %}{{ title }}{% endblock %}
{% block head %}<meta name="robots" content="noindex">{% endblock %}

{% block body %}
{% set status_label = monitor.status == 'up' ? 'Up' : (monitor.status == 'down' ? 'Down' : 'Pending') %}
<section class="page">
    <header class="page-header">
        <div class="page-header-body">
            <h1>{{ monitor.name }}</h1>
            <p class="monitor-url"><code>{{ monitor.url }}</code></p>
            <div class="meta monitor-meta">
                <span class="monitor-state is-{{ monitor.status }}">
                    <span class="monitor-dot" aria-hidden="true"></span>{{ status_label }}
                </span>
                {% if not monitor.enabled %}
                    <span class="badge">Paused</span>
                {% endif %}
                <span>last check {{ monitor.last_checked_at|ts_human }}</span>
                <span>every {{ monitor.interval_sec }} s</span>
                <span>next check {{ monitor.next_check_at|ts_human }}</span>
            </div>
        </div>
        <div class="page-header-actions">
            <a class="btn" href="{{ path('monitors_edit', {id: monitor.id}) }}">Edit</a>
            <form method="post" action="{{ path('monitors_delete', {id: monitor.id}) }}" class="inline-form">
                {{ csrf.input('monitor_action') }}
                <button type="submit" class="btn btn-danger"
                        data-confirm="Delete monitor {{ monitor.name|e('js') }}? Its incidents and history will be lost.">
                    Delete
                </button>
            </form>
        </div>
    </header>

    {% for label, messages in app.flashes %}
        {% for message in messages %}
            <p class="flash flash-{{ label }}">{{ message }}</p>
        {% endfor %}
    {% endfor %}

    {% if monitor.last_error is not null and monitor.status == 'down' %}
        <p class="flash flash-error">{{ monitor.last_error }}</p>
    {% endif %}

    <dl class="stat-cards stat-cards--compact">
        <div class="stat-card">
            <dt>Status</dt>
            <dd class="stat-card-value">{{ status_label|upper }}</dd>
            <dd class="stat-card-sub">
                {% if monitor.status_since is not null %}since {{ monitor.status_since|ts_human }}{% else %}current state{% endif %}
            </dd>
        </div>
        <div class="stat-card">
            <dt>Latency</dt>
            <dd class="stat-card-value">{{ monitor.last_response_ms is not null ? monitor.last_response_ms ~ ' ms' : '—' }}</dd>
            <dd class="stat-card-sub">HTTP {{ monitor.last_status_code ?? '—' }}</dd>
        </div>
        <div class="stat-card">
            <dt>Avg 24 h</dt>
            <dd class="stat-card-value">{{ last24h.avg_ms is not null ? last24h.avg_ms ~ ' ms' : '—' }}</dd>
            <dd class="stat-card-sub">{{ last24h.probes }} checks</dd>
        </div>
        <div class="stat-card">
            <dt>Uptime 24 h</dt>
            <dd class="stat-card-value">{{ last24h.uptime is not null ? last24h.uptime ~ '%' : '—' }}</dd>
            <dd class="stat-card-sub">avg {{ last24h.avg_ms is not null ? last24h.avg_ms ~ ' ms' : '—' }}</dd>
        </div>
        <div class="stat-card">
            <dt>Uptime 30 d</dt>
            <dd class="stat-card-value">{{ last30d.uptime is not null ? last30d.uptime ~ '%' : '—' }}</dd>
            <dd class="stat-card-sub">{{ last30d.probes }} checks</dd>
        </div>
    </dl>

    <div class="monitor-layout">
        <div class="monitor-layout__primary">
            <section class="monitor-section monitor-availability">
                <div class="monitor-section-head">
                    <h2>Availability</h2>
                    <nav class="range-switch" aria-label="Chart range">
                        {% for value, label in ranges %}
                            <a href="{{ path('monitors_get', {id: monitor.id, range: value}) }}"
                               class="range-link{% if range == value %} is-active{% endif %}"
                               {% if range == value %}aria-current="true"{% endif %}>{{ label }}</a>
                        {% endfor %}
                    </nav>
                </div>

                {% if series.probes == 0 %}
                    {{ empty.block(
                        'No probes in this range',
                        monitor.enabled ? 'The probe service will record the first check on schedule.' : 'Enable this monitor to resume checks.',
                        null,
                        null,
                        'default',
                        true,
                        true,
                        'monitor'
                    ) }}
                {% else %}
                    <div class="chart-panel">
                        <svg class="chart chart-uptime" viewBox="0 0 {{ chart.width }} {{ chart.uptime_height }}" role="img"
                             aria-label="Uptime per slot over the last {{ range }}">
                            {% for bar in chart.bars %}
                                <rect x="{{ bar.x }}" y="{{ bar.y }}" width="{{ bar.width }}" height="{{ bar.height }}"
                                      rx="2" class="chart-bar is-{{ bar.state }}"></rect>
                            {% endfor %}
                        </svg>

                        <svg class="chart chart-latency" viewBox="0 0 {{ chart.width }} {{ chart.height }}" role="img"
                             aria-label="Average latency per slot over the last {{ range }}">
                            {% for tick in chart.ticks %}
                                <line x1="{{ chart.gutter }}" y1="{{ tick.y }}"
                                      x2="{{ chart.width }}" y2="{{ tick.y }}" class="chart-grid"></line>
                                <text x="{{ chart.gutter - 8 }}" y="{{ tick.y + 3.5 }}"
                                      class="chart-tick" text-anchor="end">{{ tick.label }}</text>
                            {% endfor %}
                            {% for area in chart.areas %}
                                <path d="{{ area }}" class="chart-area"></path>
                            {% endfor %}
                            {% for segment in chart.segments %}
                                <path d="{{ segment }}" class="chart-line"></path>
                            {% endfor %}
                            {% for dot in chart.dots %}
                                <circle cx="{{ dot.x }}" cy="{{ dot.y }}" r="{{ dot.down ? 4 : 2.8 }}"
                                        class="chart-dot{% if dot.down %} is-down{% endif %}">
                                    <title>{{ dot.ms }} ms</title>
                                </circle>
                            {% endfor %}
                            <line x1="{{ chart.gutter }}" y1="{{ chart.baseline }}"
                                  x2="{{ chart.width }}" y2="{{ chart.baseline }}" class="chart-axis"></line>
                        </svg>

                        <p class="chart-caption muted small">{{ ranges[range] }} · average per slot</p>
                    </div>

                    <p class="chart-legend muted small">
                        {{ series.probes }} probes ·
                        avg {{ series.avg_ms is null ? '—' : series.avg_ms ~ ' ms' }} ·
                        peak probe {{ series.max_ms is null ? '—' : series.max_ms ~ ' ms' }}
                        <span class="legend"><span class="uptime-slot is-up"></span> up</span>
                        <span class="legend"><span class="uptime-slot is-down"></span> down</span>
                        <span class="legend"><span class="uptime-slot"></span> no data</span>
                    </p>
                {% endif %}
            </section>

            <section class="monitor-section">
                <h2>Daily rollup</h2>
                {% if days is empty %}
                    {{ empty.block(
                        'No daily rollup yet',
                        'Day buckets appear after the first successful probe.',
                        null,
                        null,
                        'default',
                        true,
                        true,
                        'monitor'
                    ) }}
                {% else %}
                    <div class="table-wrap">
                    <table class="project-table">
                        <thead>
                            <tr>
                                <th>Day (UTC)</th>
                                <th>Probes</th>
                                <th>Uptime</th>
                                <th>Avg latency</th>
                                <th>Max latency</th>
                            </tr>
                        </thead>
                        <tbody>
                            {% for day in days %}
                                <tr>
                                    <td>{{ day.start|ts_human }}</td>
                                    <td>{{ day.probes }}</td>
                                    <td>{{ day.uptime is null ? '—' : day.uptime ~ '%' }}</td>
                                    <td>{{ day.avg_ms is null ? '—' : day.avg_ms ~ ' ms' }}</td>
                                    <td>{{ day.max_ms is null ? '—' : day.max_ms ~ ' ms' }}</td>
                                </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                    </div>
                {% endif %}
            </section>
        </div>

        <aside class="monitor-section monitor-layout__aside" aria-labelledby="monitor-incidents-heading">
            <h2 id="monitor-incidents-heading">Incidents <span class="muted small">{{ incidents|length }}</span></h2>
            {% if incidents is empty %}
                {{ empty.block(
                    'No incidents',
                    'Downtime windows show here after two failed checks in a row.',
                    null,
                    null,
                    'positive',
                    true,
                    true,
                    'check'
                ) }}
            {% else %}
                <ul class="incident-list">
                    {% for incident in incidents %}
                        <li class="incident">
                            <p class="incident-head">
                                {% if incident.ended_at is null %}
                                    <span class="badge down">Ongoing</span>
                                {% endif %}
                                <span>{{ incident.started_at|ts_human }}</span>
                                {% if incident.ended_at is not null %}
                                    <span class="muted">→ {{ incident.ended_at|ts_human }}</span>
                                {% endif %}
                                <span class="muted">· {{ incident.duration }}</span>
                            </p>
                            {% if incident.error is not null %}
                                <p class="muted small incident-error">{{ incident.error }}</p>
                            {% endif %}
                        </li>
                    {% endfor %}
                </ul>
            {% endif %}
        </aside>
    </div>
</section>
{% endblock %}
