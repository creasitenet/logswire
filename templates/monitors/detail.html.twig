{% extends 'base.html.twig' %}
{% import 'macros/csrf.html.twig' as csrf %}

{% block title %}{{ title }}{% endblock %}
{% block head %}<meta name="robots" content="noindex">{% endblock %}

{% block body %}
<section class="page">
    <header class="page-header">
        <div class="page-header-body">
            <div class="monitor-title-row">
                <h1>{{ monitor.name }}</h1>
                {% include 'monitors/_status.html.twig' with {monitor: monitor} only %}
            </div>
            <p class="monitor-url"><code>{{ monitor.url }}</code></p>
            {% include 'monitors/_meta.html.twig' with {monitor: monitor} only %}
        </div>
        <div class="page-header-actions">
            <a class="btn" href="{{ path('monitors_edit', {id: monitor.id}) }}">Edit</a>
            <form method="post"
                  action="{{ path('monitors_delete', {id: monitor.id}) }}"
                  class="inline-form"
                  data-confirm="Delete monitor {{ monitor.name }}? Its incidents and history will be lost."
                  data-confirm-title="Delete monitor"
                  data-confirm-ok="Delete">
                {{ csrf.input('monitor_action') }}
                <button type="submit" class="btn btn-danger">Delete</button>
            </form>
        </div>
    </header>

    {% if monitor.enabled %}
        {# Polls the live endpoint; the response only swaps the header meta,
           stat cards and availability chart out-of-band. #}
        <div class="monitor-live-poller"
             data-live-poller
             hx-get="{{ path('monitors_live', {id: monitor.id, range: range}) }}"
             hx-trigger="every {{ poll_seconds }}s"
             hx-swap="none"
             aria-hidden="true"></div>
    {% endif %}

    {% for label, messages in app.flashes %}
        {% for message in messages %}
            <p class="flash flash-{{ label }}">{{ message }}</p>
        {% endfor %}
    {% endfor %}

    {% include 'monitors/_error.html.twig' with {monitor: monitor} only %}

    {% include 'monitors/_stats.html.twig' with {
        monitor: monitor,
        last24h: last24h,
        last30d: last30d,
    } only %}

    <div class="monitor-layout">
        <div class="monitor-layout__primary">
            {% include 'monitors/_availability.html.twig' with {
                monitor: monitor,
                series: series,
                chart: chart,
                range: range,
                ranges: ranges,
            } only %}

            {% include 'monitors/_daily.html.twig' with {days: days} only %}
        </div>

        {% include 'monitors/_incidents.html.twig' with {incidents: incidents} only %}
    </div>
</section>
{% endblock %}
