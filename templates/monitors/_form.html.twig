{# form: { name, url, interval_sec, enabled? }; with_enabled: bool #}
{% set with_enabled = with_enabled|default(false) %}
<label class="field">
    <span class="field-label">Name</span>
    <input type="text" name="name" value="{{ form.name }}" required maxlength="120" autofocus>
    <span class="field-hint">A friendly label, e.g. <code>api-prod</code>.</span>
</label>
<label class="field">
    <span class="field-label">URL</span>
    <input type="url" name="url" value="{{ form.url }}" placeholder="https://example.com/health" required maxlength="2048">
    <span class="field-hint">Only <code>http://</code> and <code>https://</code> are accepted.</span>
</label>
<label class="field">
    <span class="field-label">Check interval (seconds)</span>
    <input type="number" name="interval_sec" value="{{ form.interval_sec }}" min="60" step="30">
    <span class="field-hint">Minimum 60 s. Failed checks back off to twice the interval.</span>
</label>
{% if with_enabled %}
<label class="field-inline">
    <input type="checkbox" name="enabled" value="1" {% if form.enabled ?? true %}checked{% endif %}>
    <span>Checks enabled</span>
</label>
{% endif %}
