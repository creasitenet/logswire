{# Live last-error banner. The wrapper always exists so the poller can clear
   the message as soon as the monitor recovers (an absent OOB element cannot
   remove an existing one). #}
<div id="monitor-live-error"{% if oob|default(false) %} hx-swap-oob="true"{% endif %}>
    {% if monitor.last_error is not null and monitor.status == 'down' %}
        <p class="flash flash-error">{{ monitor.last_error }}</p>
    {% endif %}
</div>
