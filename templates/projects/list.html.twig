{% extends 'base.html.twig' %}

{% block title %}{{ title }}{% endblock %}
{% block head %}<meta name="robots" content="noindex">{% endblock %}

{% block body %}
<section class="page">
    <header class="page-header">
        <div>
            <h1>Projects</h1>
            <p class="muted small page-subtitle">One project per app or service. Issues are grouped here after Sentry-compatible ingest.</p>
        </div>
        <a class="btn btn-primary" href="{{ path('projects_new') }}">New project</a>
    </header>

    {% for label, messages in app.flashes %}
        {% for message in messages %}
            <p class="flash flash-{{ label }}">{{ message }}</p>
        {% endfor %}
    {% endfor %}

    {% include 'projects/_table.html.twig' with {projects: projects} only %}
</section>
{% endblock %}
