{% extends 'base.html.twig' %}
{% import 'macros/csrf.html.twig' as csrf %}

{% block title %}{{ title }}{% endblock %}
{% block head %}<meta name="robots" content="noindex">{% endblock %}

{% block body %}
<section class="page">
    <header class="page-header">
        <h1>Edit {{ project.name }}</h1>
    </header>

    {% if error %}
        <p class="flash flash-error">{{ error }}</p>
    {% endif %}

    <div class="form-panel">
    <form method="post" action="{{ path('projects_edit', {id: project.id}) }}" class="form">
        <label class="field">
            <span class="field-label">Name</span>
            <input type="text" name="name" value="{{ project.name }}" required maxlength="120">
        </label>
        <div class="field field-switch">
            {% include 'projects/_ingest_switch.html.twig' with {project: project, compact: false, embed: true} only %}
        </div>
        {{ csrf.input('project_action') }}
        <div class="form-actions">
            <a href="{{ path('projects_get', {id: project.id}) }}" class="btn">Cancel</a>
            <button type="submit" class="btn btn-primary">Save</button>
        </div>
    </form>
    </div>
</section>
{% endblock %}
