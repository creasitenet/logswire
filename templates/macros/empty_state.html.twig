{# title: headline; text: optional; cta_*: optional button; tone: default|positive; compact: tighter padding; inset: no dashed box (inside panels) #}
{% macro block(title, text = null, cta_label = null, cta_href = null, tone = 'default', compact = false, inset = false, icon = 'inbox') %}
    <div class="empty-state{% if tone != 'default' %} empty-state--{{ tone }}{% endif %}{% if compact %} empty-state--compact{% endif %}{% if inset %} empty-state--inset{% endif %}" role="status">
        <div class="empty-state__glyph" aria-hidden="true">
            {% if icon == 'monitor' %}
                <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M2 12h2"/><path d="M20 12h2"/><path d="M12 2v2"/><path d="M12 20v2"/><circle cx="12" cy="12" r="6"/><path d="m12 9 0 3 2 1"/></svg>
            {% elseif icon == 'project' %}
                <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M3 7v10a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V9a2 2 0 0 0-2-2h-6l-2-2H5a2 2 0 0 0-2 2Z"/></svg>
            {% elseif icon == 'issue' %}
                <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M12 9v4"/><path d="M12 17h.01"/><path d="M10.29 3.86 1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"/></svg>
            {% elseif icon == 'check' %}
                <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><path d="m8.5 12.5 2.5 2.5 4.5-5.5"/></svg>
            {% else %}
                <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="5" width="18" height="16" rx="2"/><path d="M3 9h18"/><path d="M8 5V3"/></svg>
            {% endif %}
        </div>
        <p class="empty-state__title">{{ title }}</p>
        {% if text %}
            <p class="empty-state__text">{{ text }}</p>
        {% endif %}
        {% if cta_label and cta_href %}
            <a class="btn btn-sm btn-primary empty-state__cta" href="{{ cta_href }}">{{ cta_label }}</a>
        {% endif %}
    </div>
{% endmacro %}
