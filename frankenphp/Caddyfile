{
	{$CADDY_GLOBAL_OPTIONS}
	# The container runs as www-data and /config is not writable: without this,
	# Caddy logs "unable to autosave config" on every start. Nothing reloads the
	# config at runtime, so persistence is not needed.
	persist_config off
	frankenphp {
		{$FRANKENPHP_CONFIG}
	}
}

{$SERVER_NAME:localhost} {
	log {
		level {$LOG_LEVEL:WARN}
	}

	root * /app/public
	encode zstd gzip

	# Defence in depth: the app also bounds reads in IngestController, but reject
	# oversized bodies before they reach PHP (chunked requests have no Content-Length).
	request_body {
		max_size {$INGEST_MAX_BODY_MB:12}MB
	}

	# Cheap 404s for the credential/WordPress/Adminer probes that dominate
	# Internet background noise. This is not a WAF: keep CrowdSec/fail2ban too.
	@scanner {
		path */.git/* */.env* */.config/* */.DS_Store */wp-json/* */wp-login.php */xmlrpc.php
		path */key.json */keyfile.json */firebase-adminsdk.json */firebase-key.json */application_default_credentials.json
	}
	handle @scanner {
		respond 404
	}

	@adminer query pgsql=*
	handle @adminer {
		respond 404
	}

	php_server {
		try_files {path} index.php
	}

	@static path *.css *.js *.ico *.svg *.woff2
	header @static Cache-Control "public, max-age=31536000, immutable"

	# Defense in depth (Symfony also sets these on dynamic responses)
	header {
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy strict-origin-when-cross-origin
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		Cross-Origin-Opener-Policy same-origin
		Cross-Origin-Resource-Policy same-origin
		X-Permitted-Cross-Domain-Policies none
	}

	file_server
}
