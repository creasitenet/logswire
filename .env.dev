###> symfony/framework-bundle ###
# Local development only. Never reuse this value outside `APP_ENV=dev`.
APP_SECRET=dev-insecure-secret-change-me
###< symfony/framework-bundle ###

# Local file lock (rate limiter, retention runs).
LOCK_DSN=flock

# Native installs point at the Compose PostgreSQL (published on 127.0.0.1:5433).
DATABASE_URL="postgresql://logswire:logswire@127.0.0.1:5433/logswire?serverVersion=16&charset=utf8"
